{
  "name": "stockroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "node --import tsx apps/router/src/verify-pools-cli.ts --if-configured",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/router/*.test.ts",
    "contracts:build": "bash scripts/build-contracts.sh",
    "protocol:preflight": "node --env-file-if-exists=.env.local --import tsx scripts/protocol-preflight.ts",
    "solver:check": "node --env-file-if-exists=.env.local --import tsx services/solver/index.ts --once",
    "solver:start": "node --env-file-if-exists=.env.local --import tsx services/solver/index.ts --execute",
    "manifest:prepare": "node --env-file-if-exists=.env.local --import tsx scripts/prepare-manifest.ts",
    "mainnet:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-mainnet.ts",
    "mainnet:plan": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-mainnet.ts",
    "mainnet:setup": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-mainnet.ts --execute",
    "mainnet:pause": "node --env-file-if-exists=.env.local --import tsx scripts/protocol-pause.ts --execute",
    "mainnet:unpause": "node --env-file-if-exists=.env.local --import tsx scripts/protocol-pause.ts --unpause --execute",
    "program:address": "node --env-file-if-exists=.env.local --import tsx scripts/set-program-address.ts",
    "mainnet:cost": "node --env-file-if-exists=.env.local --import tsx scripts/deployment-plan.ts",
    "treasury:plan": "node --env-file-if-exists=.env.local --import tsx scripts/treasury-accounts.ts",
    "treasury:setup": "node --env-file-if-exists=.env.local --import tsx scripts/treasury-accounts.ts --execute",
    "mainnet:status": "node --env-file-if-exists=.env.local --import tsx scripts/testing-status.ts",
    "mainnet:routes": "node --env-file-if-exists=.env.local --import tsx scripts/check-mainnet-routes.ts",
    "mainnet:packets": "node --env-file-if-exists=.env.local --import tsx scripts/check-mainnet-packets.ts",
    "mainnet:lookup:plan": "node --env-file-if-exists=.env.local --import tsx scripts/setup-lookup-table.ts",
    "mainnet:lookup:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-lookup-table.ts --execute",
    "lucky:pool": "node --env-file-if-exists=.env.local --import tsx scripts/lucky-pool.ts",
    "lucky:simulate": "node --import tsx scripts/simulate-lucky.ts",
    "pyth:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-pyth.ts",
    "packs:execution": "node --env-file-if-exists=.env.local --import tsx scripts/pack-execution.ts",
    "packs:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-pack-swap.ts",
    "mainnet:access": "node --env-file-if-exists=.env.local --import tsx scripts/protocol-access.ts",
    "positions:snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/snapshot-position-swap.ts",
    "calendar:warm": "node --env-file-if-exists=.env.local --import tsx scripts/warm-calendar.ts",
    "sectors:build": "node --import tsx scripts/build-sectors.ts",
    "earnings:build": "node --import tsx scripts/build-earnings.ts",
    "router:discover:raydium": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-raydium-pools.ts",
    "router:discover:meteora": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-meteora-pools.ts",
    "router:discover:dbc": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-meteora-dbc.ts",
    "router:dbc:refresh": "node --env-file-if-exists=.env.local --import tsx scripts/router/refresh-dbc-lifecycle.ts",
    "router:serve": "node --env-file-if-exists=.env.local --import tsx apps/router/src/server.ts",
    "router:discover:jupiter": "node --env-file-if-exists=.env.local --import tsx apps/router/src/discover-from-jupiter.ts",
    "router:trace": "node --env-file-if-exists=.env.local --import tsx scripts/router/trace-quote.ts",
    "router:build:crypto": "node --env-file-if-exists=.env.local --import tsx scripts/router/build-crypto-catalog.ts",
    "router:qualify:intermediates": "node --env-file-if-exists=.env.local --import tsx scripts/router/qualify-intermediates.ts",
    "router:admit:legs": "node --env-file-if-exists=.env.local --import tsx scripts/router/admit-routing-legs.ts",
    "router:verify:mints": "node --env-file-if-exists=.env.local --import tsx scripts/router/verify-mints-onchain.ts",
    "router:verify:pools": "node --env-file-if-exists=.env.local --import tsx scripts/router/verify-pools-onchain.ts",
    "router:validate:build-sim": "node --env-file-if-exists=.env.local --import tsx scripts/router/validate-build-sim.ts",
    "router:validate": "node --env-file-if-exists=.env.local --import tsx scripts/router/validate-native.ts",
    "router:pools:build": "node --import tsx scripts/router/build-pool-registry.ts",
    "router:benchmark:matrix": "node --env-file-if-exists=.env.local --import tsx scripts/router/benchmark-matrix.ts",
    "router:benchmark": "node --env-file-if-exists=.env.local --import tsx scripts/router/benchmark.ts",
    "router:forensics": "node --env-file-if-exists=.env.local --import tsx scripts/router/route-forensics.ts",
    "router:discover:orca": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-orca-pools.ts",
    "earn:plan": "node --env-file-if-exists=.env.local --import tsx scripts/earn/plan-demo-position.ts",
    "router:discover:private": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-private-markets.ts",
    "router:discover:intermediates": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-intermediate-routes.ts",
    "router:discover:byreal": "node --env-file-if-exists=.env.local --import tsx scripts/router/discover-byreal-pools.ts"
  },
  "dependencies": {
    "@byreal-io/byreal-clmm-sdk": "^0.2.2",
    "@coral-xyz/anchor": "0.32.1",
    "@kamino-finance/klend-sdk": "12.0.0",
    "@meteora-ag/cp-amm-sdk": "1.4.8",
    "@meteora-ag/dlmm": "1.9.14",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.12",
    "@noble/hashes": "1.8.0",
    "@orao-network/solana-vrf": "0.8.0",
    "@orca-so/common-sdk": "0.7.1",
    "@orca-so/whirlpools-sdk": "0.22.0",
    "@pythnetwork/pyth-solana-receiver": "0.16.0",
    "@pythnetwork/solana-utils": "0.6.0",
    "@raydium-io/raydium-sdk-v2": "0.2.69-alpha",
    "@solana/spl-token": "0.4.14",
    "@solana/wallet-adapter-react": "0.15.40",
    "@solana/wallet-adapter-react-ui": "0.9.40",
    "@solana/web3.js": "1.99.0",
    "@titanexchange/sdk-ts": "^0.1.6",
    "bn.js": "5.2.1",
    "buffer": "6.0.3",
    "cobe": "^2.0.1",
    "decimal.js": "10.6.0",
    "lucide-react": "0.468.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bn.js": "5.1.6",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "overrides": {
    "jito-ts": {
      "@solana/web3.js": "$@solana/web3.js"
    }
  },
  "engines": {
    "node": "22.x"
  }
}

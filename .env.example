# Server-only credentials. Mainnet required; no private wallet keys.
SOLANA_RPC_URL=
JUPITER_API_KEY=
# Worker/preflight only: Hermes authentication (Pyth Terminal).
PYTH_API_KEY=
# Existing SPL USDC token account owned by your protocol treasury.
STOCKROOM_FEE_ACCOUNT=
# Optional JSON mapping of mint -> existing protocol token account.
# For arbitrary payment tokens, configure an output-stock fee account per stock.
# Token-2022 accounts must use that mint's token program.
# USDC inputs can continue using STOCKROOM_FEE_ACCOUNT above.
STOCKROOM_FEE_ACCOUNTS={}
# V1 product configuration. No vault/pack execution is enabled by these values.
STOCKROOM_YIELD_SHARE_BPS=1000
STOCKROOM_PACK_FEE_BPS=200

# Deployed Stockroom program address; the development placeholder is rejected.
STOCKROOM_PROGRAM_ID=
# Worker-only settings. Run the solver as a persistent service, outside Vercel.
# Private key files must have mode 0600. Never paste key contents here.
SOLVER_KEYPAIR_PATH=
SOLVER_STATE_DIR=solver-state
SOLVER_MAX_SETTLEMENT_USDC_BASE_UNITS=100000000
# false uses existing solver stock inventory; true builds an atomic Jupiter swap + settlement.
SOLVER_ROUTE_STOCKS=false

# Public treasury is used by the server; vault is used by local setup.
# Candidate vault is verified again during setup; this public value is not a credential.
STOCKROOM_VAULT=HDsayqAsDWy3QvANGqh2yNraqcD8Fnjgh73Mhb3WRS5E
STOCKROOM_TREASURY_OWNER=
# Local deployment tooling only (omit from Vercel).
STOCKROOM_ADMIN_KEYPAIR_PATH=

# Local program identity file for deployment; use its public address to rebuild first.
STOCKROOM_PROGRAM_KEYPAIR_PATH=

# Public protocol address lookup table created by mainnet:lookup:setup.
STOCKROOM_LOOKUP_TABLE=

# Server-only credentials. Mainnet required; no private wallet keys.
SOLANA_RPC_URL=
JUPITER_API_KEY=
# Optional independent OpenOcean quotes through a QuickNode add-on endpoint.
# Include the /addon/807 suffix; keep this server-only.
OPENOCEAN_API_URL=
# Optional independent meta-aggregator. Obtain these from Titan/Triton.
TITAN_WS_URL=
TITAN_API_KEY=
# Pyth Pro market data. Server-only: the key is never exposed to the browser,
# and every Pyth request is made by a Henar route. Without it Henar still maps
# feeds from Pyth's public catalog and says prices are unavailable.
# Obtain from https://docs.pyth.network/price-feeds/pro/acquire-api-key
PYTH_PRO_API_KEY=
# Token Terminal asset data for the Markets -> Issuers surface. Server-only.
# The REST API is on Token Terminal's API plan; the free plan covers the
# Explorer, Sheets and MCP but issues no REST key. Without this, Henar maps
# nothing from Token Terminal and says so rather than estimating.
# Obtain from https://tokenterminal.com/pricing
TOKENTERMINAL_API_KEY=
# Ondo Global Markets data API. Server-only, and not self-serve: keys are
# issued through onboarding at https://docs.ondo.finance/api-reference/quickstart
# Without it, Ondo figures come from the mints and from onchain markets only.
ONDO_API_KEY=
# Existing SPL USDC token account owned by your protocol treasury.
STOCKROOM_FEE_ACCOUNT=
# Optional JSON mapping of mint -> existing protocol token account.
# For arbitrary payment tokens, configure an output-stock fee account per stock.
# Token-2022 accounts must use that mint's token program.
# USDC inputs can continue using STOCKROOM_FEE_ACCOUNT above.
STOCKROOM_FEE_ACCOUNTS={}
# V1 product configuration. No vault/pack execution is enabled by these values.
STOCKROOM_YIELD_SHARE_BPS=1000
STOCKROOM_PACK_FEE_BPS=200

# Deployed Stockroom program address; the development placeholder is rejected.
STOCKROOM_PROGRAM_ID=
# Worker-only settings. Run the solver as a persistent service, outside Vercel.
# Private key files must have mode 0600. Never paste key contents here.
SOLVER_KEYPAIR_PATH=
SOLVER_STATE_DIR=solver-state
SOLVER_MAX_SETTLEMENT_USDC_BASE_UNITS=100000000
# Product admission is controlled by the onchain product mask.
# All stock execution uses Jupiter directly from escrow; no Pyth or worker inventory.

# Public treasury is used by the server; vault is used by local setup.
# Candidate vault is verified again during setup; this public value is not a credential.
STOCKROOM_VAULT=HDsayqAsDWy3QvANGqh2yNraqcD8Fnjgh73Mhb3WRS5E
STOCKROOM_TREASURY_OWNER=
# Local deployment tooling only (omit from Vercel).
STOCKROOM_ADMIN_KEYPAIR_PATH=

# Local program identity file for deployment; use its public address to rebuild first.
STOCKROOM_PROGRAM_KEYPAIR_PATH=

# Public protocol address lookup table created by mainnet:lookup:setup.
STOCKROOM_LOOKUP_TABLE=

# Public worker authority for oracle-free pack quotes. Local setup can derive it from SOLVER_KEYPAIR_PATH.
PACK_QUOTE_AUTHORITY=
# Per-pack onchain execution cap; 40 USDC covers both allowed Lucky rounds.
PACK_MAX_BUDGET_USDC_BASE_UNITS=40000000

# Public request ceilings, per client per minute, per serverless instance.
# Quotes default to 60; the RPC relay defaults to 240 because one trade spends
# a blockhash read, a simulation, a submission and several status polls.
# HENAR_PUBLIC_QUOTE_BUDGET=60
# HENAR_PUBLIC_RELAY_BUDGET=240

# Contract admission policy; empty products keeps deposits disabled. Configure while paused.
# Choices: earn,limit,dca,stocks,packs,lucky. stocks additionally requires earn.
PROTOCOL_PRODUCTS=
# Defaults to admin. The all-ones system address explicitly permits public wallets.
PROTOCOL_PILOT_OWNER=
# Cumulative external USDC accepted; withdrawals never refill this budget.
PROTOCOL_ADMISSION_LIMIT_USDC_BASE_UNITS=100000000

# Market data and private markets. Read-only surfaces default on; anything
# that changes routing or the guard's verdict defaults off.
# HENAR_PYTH_PRO=1              Pyth market data on Markets and Trade
# HENAR_PYTH_FAIR_VALUE_GUARD=1 feed the Pyth assessment into the Execution Guard
# HENAR_PYTH_GUARD_MODE=observe observe | warn | enforce. Only enforce may refuse,
#                               and only on a deviation or low-quality reference;
#                               a missing Pyth reference never refuses.
# HENAR_PYTH_STREAMING=1        Pyth WebSocket streaming in the always-on worker
# HENAR_PREIPO_MARKETS=1        Markets -> Pre-IPO pages and the selector category
# HENAR_ISSUER_INTELLIGENCE=1   Markets -> Issuers: the issuer comparison and pages
HENAR_PRIVATE_MARKETS_ROUTING=
# Earn strategies. The framework and its pages are read-only and default on.
# Automation and anything that touches mainnet default off.
# HENAR_EARN_STRATEGIES=1        the strategy framework and /earn/strategies
# HENAR_EARN_STOCKS=1            Earn Stocks
# HENAR_SMART_ACCUMULATE=1       Smart Accumulate
# HENAR_RANGE_YIELD=1            Range Yield
HENAR_STRATEGY_AUTOMATION=
# Required before any strategy action may touch mainnet, in addition to an
# authorized operator signature. Never set this to run tests or a build.
HENAR_STRATEGY_MAINNET_ACTIONS=
# Public capital is not implemented for these strategies. The flag exists so
# its absence is explicit; setting it does not enable deposits.
HENAR_PUBLIC_STRATEGY_DEPOSITS=
# Where a strategy's demo capital lives, as JSON. Public addresses only; no
# private key is ever read from configuration.
# {"owner":"<pubkey>","operator":null,"feeOwner":null,"positions":["<pubkey>"],
#  "deployedCapital":"<base units>","fundedAt":"<ISO>",
#  "basis":{"collateralAmount":"..","exchangeRateAtBasis":"..","liquidityAtBasis":"..","recordedAt":".."}}
HENAR_STRATEGY_EARN_STOCKS=
HENAR_STRATEGY_SMART_ACCUMULATE=
HENAR_STRATEGY_RANGE_YIELD=
# Optional dashboard-only admin wallets, comma-separated public addresses.
# The onchain contract admin always has access. Pilot wallets are not admins.
HENAR_ADMIN_WALLETS=
